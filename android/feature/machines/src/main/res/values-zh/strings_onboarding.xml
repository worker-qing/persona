<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="machines_onb_title">添加电脑</string>
    <string name="machines_onb_title_confirm">确认电脑</string>
    <string name="machines_onb_os">这台电脑的系统</string>
    <string name="machines_onb_os_mac">Mac</string>
    <string name="machines_onb_os_linux">Linux</string>
    <string name="machines_onb_os_windows">Windows</string>
    <string name="machines_onb_name">名字</string>
    <string name="machines_onb_name_note">在 App 和网页里显示，可以用中文，最多 40 个字。</string>
    <string name="machines_onb_name_placeholder_mac">比如：我的 MacBook</string>
    <string name="machines_onb_name_placeholder_linux">比如：家里的服务器</string>
    <string name="machines_onb_name_placeholder_windows">比如：办公室的台式机</string>
    <string name="machines_onb_next">下一步</string>
    <string name="machines_onb_close">关闭</string>
    <string name="machines_onb_done">完成</string>
    <string name="machines_onb_linux_step_install">在那台电脑上打开终端，粘贴下面这一行，回车。它会装好 Persona 的后台服务并连上来。</string>
    <string name="machines_onb_linux_step_pair">这个 hub 不知道安装脚本在哪。先在那台电脑上装好 Persona Link，再在终端里粘贴这一行，回车。</string>
    <string name="machines_onb_linux_install_link">怎么装</string>
    <string name="machines_onb_linux_step_done">看到「已配对」就好了，这一屏会自己往下走。</string>
    <string name="machines_onb_windows_step_get">在那台电脑上把 Persona 的两个程序（下面这一行里的两个 .exe）放在同一个文件夹里。目前还没有安装包，要自己编译，托盘程序也还在做。</string>
    <string name="machines_onb_windows_step_run">在这个文件夹里打开 PowerShell，粘贴下面这一行，回车。</string>
    <string name="machines_onb_windows_note">它会装成登录时自动启动的后台任务，不弹窗口，也不用管理员权限。</string>
    <string name="machines_onb_mac_step_install">在那台 Mac 上装好 Persona Link。目前还没有安装包，要自己从源码编译。</string>
    <string name="machines_onb_mac_install_link">安装说明</string>
    <string name="machines_onb_mac_step_link">把配对链接发到那台 Mac，点菜单栏里的 Persona Link 图标 › 配对…，粘贴进去。</string>
    <string name="machines_onb_copy_link">拷贝配对链接</string>
    <string name="machines_onb_share_link">分享…</string>
    <string name="machines_onb_share_title">Persona 配对链接</string>
    <string name="machines_onb_copy_command">拷贝</string>
    <string name="machines_onb_copied">已拷贝</string>
    <string name="machines_onb_waiting">等「%1$s」连上来…</string>
    <string name="machines_onb_expires">%1$s 后失效</string>
    <string name="machines_onb_expired">这个链接已经过期</string>
    <string name="machines_onb_expired_hint">那台电脑还没连上来。重新生成一个链接再试。</string>
    <string name="machines_onb_new_code">重新生成</string>
    <string name="machines_onb_joined">有一台电脑想加入：%1$s，是你的吗？</string>
    <string name="machines_onb_joined_hint">确认之后，Persona 才会在上面替你干活、把模型的 Key 给它。不认识就拒绝，它会被删掉。</string>
    <string name="machines_onb_confirm">是我的电脑</string>
    <string name="machines_onb_reject">不是，删掉</string>
    <string name="machines_onb_confirmed">已添加：%1$s</string>
    <string name="machines_onb_confirmed_hint">它会出现在机器列表里，新建 Agent 时可以选它。</string>
    <string name="machines_onb_rejected">已删掉「%1$s」</string>
    <string name="machines_onb_gone">「%1$s」已经不在了</string>
    <string name="machines_onb_rejected_hint">它用过的配对链接也作废了。要加电脑，重新添加一次。</string>
    <string name="machines_onb_none_waiting">没有等待确认的电脑</string>
    <string name="machines_onb_none_waiting_hint">添加的电脑连上来以后会出现在这里。</string>
    <string name="machines_onb_offline">「%1$s」还没连上来</string>
    <string name="machines_onb_offline_hint">它连上来以后，这里会问你是不是你的电脑。那台电脑还没拿到配对链接，就重新出一个。</string>
    <string name="machines_onb_offline_hint_old">它连上来以后，这里会问你是不是你的电脑。</string>
    <string name="machines_onb_new_link">重新出链接</string>
    <string name="machines_onb_remove">删掉</string>
    <string name="machines_onb_older_title">这个 hub 还不能在手机上添加电脑</string>
    <string name="machines_onb_older_body">在网页版的「机器 › 添加电脑」或 hub 的管理界面里添加；升级 hub 以后就能在这里加。</string>
    <string name="machines_onb_status_pending">待确认</string>
    <string name="machines_onb_pending_online">它连上来了，等你确认是不是你的电脑。确认之前，Persona 不会在上面干活。</string>
    <string name="machines_onb_pending_offline">等它连上来，再确认是不是你的电脑。</string>
    <string name="machines_onb_confirm_action">确认电脑</string>
    <string name="machines_onb_code_node_service_down">这台电脑上的 Persona 后台服务没在运行。打开 Persona Link，让它重新装一次。</string>
    <string name="machines_onb_code_link_offline">这台电脑离线了：Persona Link 没在运行，或者电脑睡着了。</string>
    <string name="machines_onb_code_never_connected">这台电脑还没连上来过：在它上面用配对链接配对一次。</string>
    <string name="machines_onb_code_node_outdated">这台电脑上的 Persona 太旧了，没法从这里更新。在那台电脑上重新安装一次。</string>
    <string name="machines_onb_err_tls_required">hub 还没打开安全连接，电脑接不进来。到 hub 的管理界面 › 网络里打开安全连接后再试。</string>
    <string name="machines_onb_err_mesh_member">这台 hub 是组里的成员，到中心 hub 上添加电脑。</string>
    <string name="machines_onb_err_too_many_pending">已经有 3 台电脑在等你确认。先确认或删掉它们，再添加。</string>
    <string name="machines_onb_err_forbidden">这个设备不能添加电脑。用已经登录好的 App 或网页再试。</string>
    <string name="machines_onb_err_invalid_name">名字不能为空，最多 40 个字。</string>
    <!-- Adding a computer to the current assistant (docs/assistant/managers.md "Clients"). -->
    <string name="machines_onb_added_under">这台电脑加到了「%1$s」名下。</string>
    <string name="machines_onb_assistant_offline">「%1$s」离线，暂时不能给它添加电脑。</string>
    <string name="machines_onb_never_connected">还没连上来过</string>
    <string name="machines_onb_waiting_confirm">等你确认</string>
    <plurals name="machines_onb_too_many_never">
        <item quantity="other">已经加了 %1$d 台电脑，它们都还没连上来过。删掉用不上的，再添加新的。</item>
    </plurals>
    <plurals name="machines_onb_too_many_waiting">
        <item quantity="other">已经有 %1$d 台电脑在等着：没连上来的可以删掉，连上来的先确认是不是你的，再添加新的。</item>
    </plurals>
