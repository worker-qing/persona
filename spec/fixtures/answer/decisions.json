{
  "schema_version": 1,
  "cases": [
    {
      "name": "plan_approve_all",
      "description": "对话页全部放行使用 bypassPermissions。",
      "source": [
        "ios/Persona/Views/Interactions/InteractionViews.swift：PlanForm"
      ],
      "input": {
        "profile": "ios_current",
        "interaction": {
          "id": "example_request",
          "machine_id": "example_machine",
          "session_id": "example_session",
          "kind": "plan",
          "plan": "# 示例计划\n补充单元测试。"
        },
        "operation": {
          "action": "approve_all",
          "entry": "conversation",
          "rejecting": false,
          "feedback": ""
        }
      },
      "expected": {
        "allowed": true,
        "resolution": {
          "approve": true,
          "mode": "bypassPermissions"
        }
      },
      "derived": true
    },
