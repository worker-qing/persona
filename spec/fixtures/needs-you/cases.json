    {
      "name": "cards_of_one_session_are_one_row",
      "description": "A session with a plan, a question and a permission waiting is one row; its cards sit under it, oldest first.",
      "input": {
        "sessions": [
          {
            "machine_id": "studio",
            "session_id": "s1",
            "title": "Support HEIC in the photo sync",
            "cwd": "/home/user/project",
            "state": "needs_you",
            "updated_at": "2026-11-10T08:00:00Z",
            "state_since": "2026-11-10T08:00:00Z"
          }
        ],
        "interactions": [
          {
            "id": "ix-plan",
            "machine_id": "studio",
            "session_id": "s1",
            "kind": "plan",
            "created_at": "2026-11-10T08:00:00Z",
            "plan": "## Support HEIC\n- convert on export"
          },
          {
            "id": "ix-question",
            "machine_id": "studio",
            "session_id": "s1",
            "kind": "question",
            "created_at": "2026-11-10T08:01:00Z",
            "questions": [
              {
                "question": "Which port should the demo use?",
                "options": [
                  {
                    "label": "8080"
                  },
                  {
                    "label": "9090"
                  }
                ]
              }
            ]
          },
          {
            "id": "ix-permission",
            "machine_id": "studio",
            "session_id": "s1",
            "kind": "permission",
            "created_at": "2026-11-10T08:02:00Z",
            "tool_name": "Bash",
            "summary": "npm test"
          }
        ],
        "mutes": {
          "sessions": [],
          "spaces": [],
          "allowed": []
        },
        "quiet": []
      },
      "expected": {
        "rows": [
          {
            "id": "agent:studio/s1",
            "cards": [
              "ix-plan",
              "ix-question",
              "ix-permission"
            ]
          }
        ],
        "badge": 1
      },
      "source": [
        "apple/Persona/Views/Chats/AgentsNeedsYouRows.swift AgentsNeedsYou.rows",
        "issue #3580"
      ]
    },
