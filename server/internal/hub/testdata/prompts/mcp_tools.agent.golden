[
  {
    "name": "mail_accounts",
    "description": "List the mail accounts the user has configured (name, address, provider). Call this before searching or sending mail so you know which account_id to use.",
    "input_schema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "mail_search",
    "description": "Search mail. Returns message summaries (uid, subject, from, date, snippet). Use account_id from mail_accounts; omit it to search every account's inbox at once. For Gmail the query uses Gmail search syntax (from:, subject:, has:attachment, newer_than:7d); other providers search the full text on their server. Some servers do not search at all (NetEase 163 finds nothing for any word): when the server finds nothing, subjects, senders and recipients are matched instead (every word must appear, case does not matter; bodies are not searched), a stretch of the newest mail at a time, and the result says which before_uid looks further back.",
    "input_schema": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "description": "Account id from mail_accounts; omit to search all inboxes"
        },
        "mailbox": {
          "type": "string",
          "description": "Mailbox name, default INBOX"
        },
        "query": {
          "type": "string",
          "description": "Search text or Gmail query"
        },
        "limit": {
          "type": "integer",
          "description": "Max results, default 20, max 200"
        },
        "before_uid": {
          "type": "integer",
          "description": "Return messages with UID lower than this, for paging"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "mail_read",
    "description": "Read one message in full: headers, plain text, HTML and the attachment list (each with its id for mail_save_attachment). Does not mark the message as read.",
    "input_schema": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string"
        },
        "uid": {
          "type": "integer"
        },
        "mailbox": {
          "type": "string",
          "description": "Mailbox name, default INBOX"
        }
      },
      "required": [
        "account_id",
        "uid"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "mail_save_attachment",
    "description": "Save one attachment of a message (a PDF, CSV, xlsx, zip…) as a file on this computer, the one you run on, and return its path. The id is the one mail_read lists after the attachment. Files go under the Persona data directory's attachments/mail folder, in the subfolder dir if given; an existing file is never overwritten (the new one gets a numbered name). At most 25 MB. Does not mark the message as read. Read, unzip or move the saved file with your own tools afterwards.",
    "input_schema": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string"
        },
        "uid": {
          "type": "integer"
        },
        "mailbox": {
          "type": "string",
          "description": "Mailbox name, default INBOX"
        },
        "attachment_id": {
          "type": "string",
          "description": "The id mail_read lists after the attachment"
        },
        "dir": {
          "type": "string",
          "description": "Subfolder to save into, relative (e.g. bills/2026-10); no absolute paths, '..' or hidden folders"
        }
      },
      "required": [
        "account_id",
        "uid",
        "attachment_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "mail_send",
    "description": "Send an email from one of the user's accounts. The user must approve each send on their phone before it goes out, so fill in a clear subject and body. To reply, pass in_reply_to with the original Message-ID and references with the original References chain plus that Message-ID.",
    "input_schema": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string"
        },
        "to": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/address"
          }
        },
        "cc": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/address"
          }
        },
        "bcc": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/address"
          }
        },
        "subject": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "description": "Plain-text body"
        },
        "html": {
          "type": "string",
          "description": "Optional HTML body"
        },
        "in_reply_to": {
          "type": "string",
          "description": "Message-ID being replied to"
        },
        "references": {
          "type": "string",
          "description": "Space-separated Message-IDs from the original thread"
        }
      },
      "required": [
        "account_id",
        "to",
        "subject",
        "text"
      ],
      "$defs": {
        "address": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          },
          "required": [
            "email"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "report_to_supervisor",
    "description": "Report to the Persona assistant that handed you this task and reviews it (your supervisor), not to the user: a decision you need from it (question), that you are stuck (blocked), that you finished with the evidence for each acceptance criterion (done), or where you are in a long task (progress). It reads it within minutes, and answers or redirects you by message. Only for a task Persona supervises; elsewhere nobody receives it and it says so. Don't use it for every small step, and keep asking the user what only the user can decide the usual way. A question that does not hold you up (you can go on with other work, and a late answer costs nothing: which name to prefer, a style choice) can be sent with `urgent: false`: nobody is woken for it, and the owner sees it in their next morning or evening briefing, under \"Can wait\", and answers you in your chat. If no briefing is switched on it goes as an urgent question, and the answer says so. Ask what blocks you without it. `urgent` is for kind `question` only.\n\nReport individual done_when entries as they change with `criteria`: `number` is the one-based position in the task's ordered done_when, `state` is pending / met / not_met, and evidence is required for met and not_met (a command plus output, a link or the gap). Omitted entries keep their previous state; pending resets an entry. This persists immediately and updates the task's count, but is an agent report, not the supervisor's acceptance. The supervisor receives the entries and evidence in its supervision message and still reviews the task itself.",
    "input_schema": {
      "type": "object",
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "progress",
            "question",
            "blocked",
            "done"
          ]
        },
        "text": {
          "type": "string",
          "description": "what you report, in a few lines: the question with its options, what blocks you, what you did"
        },
        "evidence": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          },
          "description": "links, command output, file paths that show it (a PR, CI, a screenshot)"
        },
        "criteria": {
          "type": "array",
          "maxItems": 6,
          "description": "only the done_when entries you are updating; does not accept or close the task",
          "items": {
            "type": "object",
            "required": [
              "number",
              "state"
            ],
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1,
                "description": "one-based position in the task's done_when"
              },
              "state": {
                "type": "string",
                "enum": [
                  "pending",
                  "met",
                  "not_met"
                ]
              },
              "evidence": {
                "type": "string",
                "maxLength": 600,
                "description": "required for met/not_met; command + output, link, or what is missing"
              }
            }
          }
        },
        "step": {
          "type": "integer",
          "description": "the step you are on (progress)"
        },
        "steps": {
          "type": "integer",
          "description": "how many steps there are in all"
        },
        "urgent": {
          "type": "boolean",
          "description": "question only; default true. false: it can wait for the owner's next morning or evening briefing and you go on meanwhile; nobody is woken"
        }
      }
    }
  },
  {
    "name": "todo_decisions",
    "description": "The decisions in force on the Persona todo you work on: the calls the user made on it (written in the todo, or answered in your question cards) and the ones agents noted, each with who made it (`by`: user or agent). They are what was settled before or while you worked: read them before choosing again, and again after your context was compacted. Only the todo you work on; elsewhere it says there is none.",
    "input_schema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "todo_decision_add",
    "description": "Note a call you made on the Persona todo you work on, so whoever picks it up next (another agent, you after compaction, the user) does not decide it again: a choice between ways of doing it, a default you settled on, something you ruled out. It shows in the todo as noted by an agent, not as the user's. Not for progress (that is report_to_supervisor) and not for what only the user can decide: ask them. To change an earlier decision an agent made, name it in supersedes_id (its id from todo_decisions); the user's own decisions you cannot replace: ask them.",
    "input_schema": {
      "type": "object",
      "required": [
        "question",
        "choice"
      ],
      "properties": {
        "question": {
          "type": "string",
          "description": "what was to decide, in one line"
        },
        "choice": {
          "type": "string",
          "description": "what you chose"
        },
        "reason": {
          "type": "string",
          "description": "why, in a line or two"
        },
        "supersedes_id": {
          "type": "string",
          "description": "the earlier decision of this todo this one replaces"
        }
      }
    }
  },
  {
    "name": "todo_bind_thread",
    "description": "Bind the Persona todo you work on to a chat thread (a topic in a group chat or a conversation), so the thread and the todo are known to belong together. One thread per todo, and a thread can belong to one todo only. It only records the link: it posts nothing to the thread. Use it when you were given the thread to work in or opened it for this todo; the identifiers are the ones the thread's own messages carry, never guessed. Only the todo you work on: naming another todo in todo_id is refused. A todo that already has another thread keeps it: changing it is the user's call, ask them. Binding the same thread again only updates its title.",
    "input_schema": {
      "type": "object",
      "required": [
        "channel",
        "chat_id",
        "thread_id"
      ],
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "the todo you work on; leave it out, or give the id you know it by (any other id is refused)"
        },
        "channel": {
          "type": "string",
          "description": "the channel the thread is on, by its channel id: feishu for a Feishu chat (not the app name written otherwise, not a guess)"
        },
        "chat_id": {
          "type": "string",
          "description": "the chat the thread is in; for feishu the chat id (oc_…)"
        },
        "thread_id": {
          "type": "string",
          "description": "the thread in that chat; for feishu the thread_id of the message events (omt_…), not the root message's message_id (om_…)"
        },
        "title": {
          "type": "string",
          "description": "a short label for the thread, shown beside the todo"
        }
      }
    }
  }
]
