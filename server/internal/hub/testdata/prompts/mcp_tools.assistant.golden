[
  {
    "name": "mail_accounts",
    "description": "List the mail accounts the user has configured (name, address, provider). Call this before searching or sending mail so you know which account_id to use.",
    "input_schema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "mail_search",
    "description": "Search mail. Returns message summaries (uid, subject, from, date, snippet). Use account_id from mail_accounts; omit it to search every account's inbox at once. For Gmail the query uses Gmail search syntax (from:, subject:, has:attachment, newer_than:7d); other providers search the full text on their server. Some servers do not search at all (NetEase 163 finds nothing for any word): when the server finds nothing, subjects, senders and recipients are matched instead (every word must appear, case does not matter; bodies are not searched), a stretch of the newest mail at a time, and the result says which before_uid looks further back.",
    "input_schema": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "description": "Account id from mail_accounts; omit to search all inboxes"
        },
        "mailbox": {
          "type": "string",
          "description": "Mailbox name, default INBOX"
        },
        "query": {
          "type": "string",
          "description": "Search text or Gmail query"
        },
        "limit": {
          "type": "integer",
          "description": "Max results, default 20, max 200"
        },
        "before_uid": {
          "type": "integer",
          "description": "Return messages with UID lower than this, for paging"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "mail_read",
    "description": "Read one message in full: headers, plain text, HTML and the attachment list (each with its id for mail_save_attachment). Does not mark the message as read.",
    "input_schema": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string"
        },
        "uid": {
          "type": "integer"
        },
        "mailbox": {
          "type": "string",
          "description": "Mailbox name, default INBOX"
        }
      },
      "required": [
        "account_id",
        "uid"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "mail_save_attachment",
    "description": "Save one attachment of a message (a PDF, CSV, xlsx, zip…) as a file on this computer, the one you run on, and return its path. The id is the one mail_read lists after the attachment. Files go under the Persona data directory's attachments/mail folder, in the subfolder dir if given; an existing file is never overwritten (the new one gets a numbered name). At most 25 MB. Does not mark the message as read. Read, unzip or move the saved file with your own tools afterwards.",
    "input_schema": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string"
        },
        "uid": {
          "type": "integer"
        },
        "mailbox": {
          "type": "string",
          "description": "Mailbox name, default INBOX"
        },
        "attachment_id": {
          "type": "string",
          "description": "The id mail_read lists after the attachment"
        },
        "dir": {
          "type": "string",
          "description": "Subfolder to save into, relative (e.g. bills/2026-10); no absolute paths, '..' or hidden folders"
        }
      },
      "required": [
        "account_id",
        "uid",
        "attachment_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "mail_send",
    "description": "Send an email from one of the user's accounts. The user must approve each send on their phone before it goes out, so fill in a clear subject and body. To reply, pass in_reply_to with the original Message-ID and references with the original References chain plus that Message-ID.",
    "input_schema": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string"
        },
        "to": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/address"
          }
        },
        "cc": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/address"
          }
        },
        "bcc": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/address"
          }
        },
        "subject": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "description": "Plain-text body"
        },
        "html": {
          "type": "string",
          "description": "Optional HTML body"
        },
        "in_reply_to": {
          "type": "string",
          "description": "Message-ID being replied to"
        },
        "references": {
          "type": "string",
          "description": "Space-separated Message-IDs from the original thread"
        }
      },
      "required": [
        "account_id",
        "to",
        "subject",
        "text"
      ],
      "$defs": {
        "address": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          },
          "required": [
            "email"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "ask_user",
    "description": "Ask the user one or more multiple-choice questions on their iPhone (a card in this conversation plus a push notification) and wait for the answers. Use it to confirm anything risky (sending messages / email for them, deleting, changing live systems) or to let them pick between options. AskUserQuestion does not work here; use this instead. The user can also type a free-form answer. Waits up to 2 hours; if the user writes in this conversation instead of picking an option, the question is withdrawn and the tool returns at once, with their message following. If nobody answers in time, the question becomes a to-do that waits for the user's call (in their to-do list and the next briefing), and their answer comes to this conversation later as a new message. With a deadline (each question then recommends one of its options): if nobody answers by it and you marked it reversible, the recommended options are taken by default and recorded on the question's to-do; one that cannot be undone is only reminded again and keeps waiting.",
    "input_schema": {
      "type": "object",
      "required": [
        "questions"
      ],
      "properties": {
        "deadline": {
          "type": "string",
          "description": "optional: until when the questions wait, a duration (\"30m\", \"4h\") or an RFC 3339 time, 1 minute to 30 days ahead; needs reversible and a recommend on every question"
        },
        "reversible": {
          "type": "boolean",
          "description": "with deadline: whether going ahead with the recommended options can be undone later. false for deleting, sending anything to other people, spending money or changing production: those are never taken by default"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "question",
              "options"
            ],
            "properties": {
              "question": {
                "type": "string"
              },
              "header": {
                "type": "string",
                "description": "short label, ≤12 chars"
              },
              "multiSelect": {
                "type": "boolean"
              },
              "recommend": {
                "type": "string",
                "description": "the label of the option you recommend; required with deadline"
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "label"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "notify_user",
    "description": "Send the user a push notification right now (works when the app is closed). Tapping it opens this conversation. Use for results of scheduled runs and anything time-sensitive; don't notify for ordinary replies (they get one automatically).",
    "input_schema": {
      "type": "object",
      "required": [
        "title",
        "body"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "supervision_finish",
    "description": "Finish handling a supervision wake-up without cluttering the user's main conversation. Use visibility=\"silent\" when no user decision or useful result needs to be shown, with a short summary of what you checked or changed; then end the turn. The complete turn stays available in the expandable supervision record. Use visibility=\"user\" to explicitly show the turn without sending a notification. notify_user, ask_user, and task_review user conclusion cards also promote the turn. A promoted turn cannot be made silent again. This tool is only for supervision-triggered turns, not normal user messages.",
    "input_schema": {
      "type": "object",
      "required": [
        "visibility",
        "summary"
      ],
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "silent",
            "user"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "schedule_followup",
    "description": "Wake yourself up later: at the given time Persona sends `prompt` into this conversation (or a new one) as if the user wrote it, you do the work, and the user gets a push with your answer (with `push: \"asked\"`, only what you send with notify_user). Use for \"remind me…\", \"check again in an hour\", meeting prep 10 minutes before a meeting, watching something until it changes. `at` is RFC 3339 (2026-10-27T09:50:00+08:00) or relative (\"30m\", \"2h\", \"1d\"). For something to do again and again (a patrol every 30 minutes) pass `every` (\"30m\", \"2h\", at least 5m) once: Persona repeats it by itself and the user sees, edits and stops it in the app; never schedule the next run from inside a run. An `every` task can take `until`, an instant after which the task stops (RFC 3339 or 30m / 2h / 1d, the same forms as `at`, not a bare clock time and not a condition to watch for): after that instant Persona turns it off and records a skipped run instead of running. A one-off ignores `until`. Omit it to keep an existing task's end time; null clears it. Which model and permission mode a task runs with is the user's choice in the app.",
    "input_schema": {
      "type": "object",
      "required": [
        "prompt"
      ],
      "properties": {
        "at": {
          "type": "string",
          "description": "when (the first run, with every); default with every: one interval from now"
        },
        "every": {
          "type": "string",
          "description": "repeat this often, e.g. 30m"
        },
        "prompt": {
          "type": "string",
          "description": "what to do then, self-contained"
        },
        "title": {
          "type": "string",
          "description": "short label shown in the app"
        },
        "new_conversation": {
          "type": "boolean",
          "description": "start a fresh conversation instead of continuing this one"
        },
        "push": {
          "type": "string",
          "enum": [
            "every",
            "asked"
          ],
          "description": "every (default for a new task): each run's answer is pushed to the user; asked: only what a run sends with notify_user, for a task that watches something (it then runs in its own conversation, not this one). Omit to keep an existing task's"
        },
        "until": {
          "type": [
            "string",
            "null"
          ],
          "description": "optional end time (RFC 3339 or 30m / 2h / 1d). After it, Persona turns the task off and records a skipped run instead of running. Omit to keep an existing task's end time; null clears it. Ignored for a one-off."
        }
      }
    }
  },
  {
    "name": "schedule_routine",
    "description": "Set up a recurring routine: every day (or on some weekdays) at a time, Persona starts a new conversation with `prompt`, you do the work, and the user gets a push with your answer (with `push: \"asked\"`, only what you send with notify_user). Use for \"每天 9 点给我早报\", \"每周五下午起草周报\". For one-off reminders use schedule_followup. Pass `id` (from list_followups) to change an existing routine: only the fields you give change; `enabled: false` pauses it. A routine can take `until`, an instant after which it stops (RFC 3339 or 30m / 2h / 1d, not a bare clock time): Persona then turns it off and records a skipped run instead of running. Omit `until` to keep an existing routine's end time; null clears it. Times are in the user's time zone.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "to change an existing routine"
        },
        "title": {
          "type": "string",
          "description": "short name shown in the app, e.g. 早报"
        },
        "prompt": {
          "type": "string",
          "description": "what to do each time, self-contained"
        },
        "time": {
          "type": "string",
          "description": "HH:MM, 24-hour"
        },
        "weekdays": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "description": "1 = Monday … 7 = Sunday; omit or empty = every day"
        },
        "enabled": {
          "type": "boolean"
        },
        "push": {
          "type": "string",
          "enum": [
            "every",
            "asked"
          ],
          "description": "every (default for a new task): each run's answer is pushed to the user; asked: only what a run sends with notify_user, for a task that watches something (it then runs in its own conversation). Omit to keep an existing task's"
        },
        "until": {
          "type": [
            "string",
            "null"
          ],
          "description": "optional end time (RFC 3339 or 30m / 2h / 1d). After it, Persona turns the task off and records a skipped run instead of running. Omit to keep an existing task's end time; null clears it. Ignored for a one-off."
        }
      }
    }
  },
  {
    "name": "delete_routine",
    "description": "Delete a scheduled task (routine or follow-up) by id (from list_followups). Confirm with the user first unless they asked for it.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "list_followups",
    "description": "List every scheduled task (with ids): follow-ups that have not run yet, repeating ones, daily routines. A repeating task with an end time shows that time.",
    "input_schema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "cancel_followup",
    "description": "Cancel a scheduled follow-up or a repeating task by id (from list_followups).",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "list_places",
    "description": "The user's saved places (home, the office, …) with their coordinates and reminder radius, as the user set them in Settings › Assistant › Saved Places or as you saved them with save_place. Read them before a reminder by place; never take a place's coordinates from memory.",
    "input_schema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "save_place",
    "description": "Save a place to the user's saved places, or change the saved place of the same name. Only for a place the user just confirmed in this conversation (their current location while they are there, or a phone_location_search result they picked); the user sees and edits it in Settings › Assistant › Saved Places.",
    "input_schema": {
      "type": "object",
      "required": [
        "name",
        "latitude",
        "longitude"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "What the user calls it, e.g. 家 or 公司 (at most 40 characters)"
        },
        "address": {
          "type": "string",
          "description": "The address, as phone_location_search gave it"
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "radius_meters": {
          "type": "integer",
          "description": "The reminder circle, 100–2000; leave it out for 150"
        }
      }
    }
  },
  {
    "name": "machines_list",
    "description": "List the user's computers and their observed connection state, system information, resource availability, working agents, failing launchers and node version status. Use this before choosing where to start work. Resource samples older than 30 seconds are not current. Null values have an accompanying reason; do not infer missing facts or rank computers from incomplete data.",
    "input_schema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "agents_list",
    "description": "The Claude Code / Codex agents running on the user's computers (herdr), with their state: needs_you (waiting for an answer / approval), working, unread (finished, result not looked at), idle. Each line has machine, session id, project, title, last update and the last thing the agent said. Known Claude Code switch states appear as ultracode=on/off; an omitted state is unknown. ultracode=on means every substantive task runs a multi-agent dynamic workflow, independently of thinking effort. Let it finish and wait for workflow results without nudging it. Much faster and more accurate than ssh + herdr. At the end: the launchers that failed their last health check, by machine (agent_start and task_plan move off them).\n\nA line under an agent is something waiting for the user: a question lists its options and the interaction id to answer it with (interaction_answer), an approval is the user's to give in the app.",
    "input_schema": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "active",
            "needs_you",
            "working",
            "unread",
            "idle",
            "archived",
            "all"
          ],
          "description": "default active = needs_you + working + unread; archived: only the archived sessions (agent_unarchive restores them); the others leave archived ones out, all lists them marked archived"
        },
        "machine": {
          "type": "string"
        },
        "query": {
          "type": "string",
          "description": "filter by title / project / directory"
        }
      }
    }
  },
  {
    "name": "agent_read",
    "description": "Read the recent conversation of one agent (from agents_list): the user's messages, what the agent said, tool calls in short form. `turns` = how many recent exchanges (default 2, max 10). Use it to answer the user's follow-ups about work an agent or task already did (its conclusion, a PR link, why it stopped) instead of asking the agent with agent_send, which makes it take another turn (a closed agent is resumed first) while the user waits.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id"
      ],
      "properties": {
        "machine": {
          "type": "string"
        },
        "session_id": {
          "type": "string",
          "description": "full id or its first 8 characters"
        },
        "turns": {
          "type": "integer"
        }
      }
    }
  },
  {
    "name": "agent_send",
    "description": "Send a message to an agent as the user would type it (answers its question, tells it to continue, gives new instructions). Queued if the agent is working. Only send what the user asked for. An agent that is not running any more (a finished task's agent is closed after a few idle minutes) is resumed first, in the same session with the same machine, directory and launcher, so you can keep working with it. A text of only /exit or /quit closes a running agent and its terminal tab (the session can still be resumed later) and does nothing to one that is not running; a finished task's agent is closed for you, so there is no need to.\n\nWhen a dialog holds the agent's terminal the send is refused (dialog_open) with the dialog's first line, and whether it is only a notice that Enter closes (\"Enter to continue\", no options). Send again with dismiss_notice true to close such a notice first. Confirmations, permissions and pickers are never closed for you: tell the user, or answer them with interaction_answer.\n\nWhen you hand new work to an agent that runs already (one the user opened, a long-lived one that passes work on), give task from the main conversation: once the text is sent the agent is your supervised task, as agent_supervise makes one (a todo with the text as its notes, the agent on it, done_when, a card in the conversation; 督办 messages, task_review), so the work is tracked instead of only said. Put the criteria in the text too: the agent is told only what the text says. An agent already on one of your tasks takes more of it under the same title (no second task; done_when is updated); a different title is refused, so other work is not filed under that task. An agent on the user's own todo or another conversation's task is refused. Refused means nothing was sent. If the send fails, no task is made. Leave task out, or null, for a reply, a nudge or a decision on work it already has; a task with nothing in it (a blank title, no non-blank done_when, no expect_minutes above 0, no other key) counts as left out too.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id",
        "text"
      ],
      "properties": {
        "machine": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "dismiss_notice": {
          "type": "boolean",
          "description": "Press Enter first to close a notice that only says \"Enter to continue\" (no options). Any other dialog still refuses the send."
        },
        "attachments": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          },
          "description": "pictures and files the user gave you for it, by their absolute paths on your computer: a picture they sent (the path Claude Code gives it), a file the app put in their message. They are copied to the agent's computer and listed at the end of its message, and the text's mentions of them name the copies. Only those the user gave you in this conversation are accepted"
        },
        "task": {
          "type": [
            "object",
            "null"
          ],
          "description": "new work: make it your supervised task first (main conversation only); null for a reply",
          "additionalProperties": false,
          "properties": {
            "title": {
              "type": "string",
              "description": "the task in a short line (Chinese, under 20 characters)"
            },
            "done_when": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string"
              },
              "description": "results you can check when it says it is done (a PR merged, a sheet's link, what the live system answers)"
            },
            "expect_minutes": {
              "type": "integer",
              "description": "how long it should take from now; longer without progress counts as stuck"
            }
          }
        }
      }
    }
  },
  {
    "name": "agent_interrupt",
    "description": "Stop what an agent (from agents_list) is doing right now, and optionally redirect it: its current turn is cut off (Esc in its terminal, or its runtime's cancel), the agent and its session stay, and `then` is sent to it at once as the user would type it. Use it when waiting is worse than stopping: it works in the wrong direction, waits in a loop (sleep, polling), repeats a failing step, collides with another agent, or the user said stop. To add a word to an agent that works fine, use agent_send instead (queued behind its turn). What it did already is not undone (files it changed, commands it ran): tell it in `then` what to put back. Not for assistant conversations, and not for agents that can only be read.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "description": "the machine's id or name, as agents_list shows it"
        },
        "session_id": {
          "type": "string",
          "description": "the agent's session id, or its first 8 characters"
        },
        "then": {
          "type": "string",
          "description": "the new instruction, sent right after it stopped; empty: just stop it"
        }
      }
    }
  },
  {
    "name": "agent_start",
    "description": "Start a new Claude Code agent in the terminal engine (herdr or Orca) of one of the user's computers, in a project directory, with a first prompt. Use for real development work instead of doing it here. Check machines_list for current machine resources and availability before choosing a machine. Returns the new session id. When the launcher failed its last health check on that machine, the agent starts on a machine where it works (a directory under the home moves to that home) and the answer says so.\n\nWhen the work needs a branch and checkout of its own (work in parallel with what is already open in that repository), give `worktree.branch`: Persona makes the worktree through the machine's engine first (herdr's or Orca's own, so it is listed there and in the app, under the workspace `cwd` is in) and starts the agent in it. Do not tell the agent to run `git worktree add` itself: a worktree made that way is invisible to Orca and to the app. An existing local branch is checked out; a new one starts at the HEAD of the workspace `cwd` is in. A branch already checked out elsewhere is refused.\n\nGive `ultracode: true` for a large task: one that spans many files or needs checking from several angles (design, tests, review). Claude Code then runs every substantial step as a multi-agent workflow: slower and costlier, so leave it off for small or quick work. Do not write the word \"ultracode\" into the prompt instead. Claude Code agents only (2.1.284 or later): any other agent, or an older Claude Code, refuses the start. Whether it is really on shows as `ultracode=on` in agents_list once Claude Code confirms it.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "cwd",
        "prompt"
      ],
      "properties": {
        "machine": {
          "type": "string"
        },
        "cwd": {
          "type": "string",
          "description": "absolute path or ~/…; with worktree, a directory of the repository to branch from"
        },
        "prompt": {
          "type": "string"
        },
        "attachments": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          },
          "description": "pictures and files the user gave you for it, by their absolute paths on your computer: a picture they sent (the path Claude Code gives it), a file the app put in their message. They are copied to the agent's computer and listed at the end of its message, and the text's mentions of them name the copies. Only those the user gave you in this conversation are accepted"
        },
        "launcher": {
          "type": "string",
          "description": "launcher name, one that machine has (a name it lacks is refused, listing the ones it has); empty: the default, or one the machine has when it lacks the default (claude first; the answer says so)"
        },
        "ultracode": {
          "type": "boolean",
          "description": "turn Claude Code's ultracode on for this agent (multi-agent workflows for every substantial step); default false"
        },
        "worktree": {
          "type": "object",
          "description": "start the agent in a new worktree of cwd's repository, made by the machine's engine",
          "required": [
            "branch"
          ],
          "properties": {
            "branch": {
              "type": "string",
              "description": "the branch to check out (made from the workspace's HEAD when it does not exist)"
            }
          }
        },
        "tier": {
          "type": "string",
          "description": "An Agent preset: one of the tiers the snapshot's 模型档位 line lists for the profile in use, each with what it is for; pick the one whose description fits the work. Resolved before the user is asked, and the card shows it. Explicit launcher/model/effort override its values."
        },
        "effort": {
          "type": "string",
          "description": "Explicit effort override; omit to use the tier or purpose default."
        },
        "model": {
          "type": "string",
          "description": "Explicit model override: a model id the agent takes (an alias such as opus, or a gateway's own id; letters, digits and . _ - / : @ [ ] only, or a leading ~ as in ~vendor/model-latest). Omit to use the tier or purpose default."
        }
      }
    }
  },
  {
    "name": "agent_supervise",
    "description": "Take an agent you did not hand out (opened by hand on the Agents page, or by agent_start without a task) under your supervision, from the main conversation, as if task_plan had started it: it becomes a task of this conversation (a todo, its card in the conversation), you get a 督办 message when it needs you (waits for review, stopped short, waits for an answer, makes no progress, reports to you), and you close it with task_review. On an agent of a task you supervise already, it sets that task's done_when and expect_minutes instead. An agent of another conversation's task stays that conversation's.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "description": "the machine's id or name, as agents_list shows it"
        },
        "session_id": {
          "type": "string",
          "description": "the agent's session id, or its first 8 characters"
        },
        "title": {
          "type": "string",
          "description": "the task in a short line (Chinese, under 20 characters); empty: the agent's title"
        },
        "done_when": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string"
          },
          "description": "results you can check when it says it is done (a PR merged, a screenshot, what the live system answers)"
        },
        "expect_minutes": {
          "type": "integer",
          "description": "how long it should take from now; longer without progress counts as stuck"
        }
      }
    }
  },
  {
    "name": "agent_archive",
    "description": "Archive a coding agent's session (from agents_list) when the user asks to archive or tidy up agents: it leaves the Agents list for Archived in the app, nothing is deleted, and agent_unarchive brings it back (never remove a session any other way). Persona also asks the agent's own tool to archive it where that tool has an archive (Codex); the result says whether it did (native: done / pending / unsupported). Without close the agent itself is not closed: one open on its computer stays open. With close, its agent is also closed on its computer the way a finished task's agent is (its tab and process go, its transcript stays, and the next message to it resumes it): only when the user asks to close it too, and the user confirms on the phone first (declined: nothing changes). A busy agent is refused and nothing changes: working, waiting for an answer or background work, and for close also a /loop, queued messages or a server it runs. When the close does not happen the session stays archived and still open on the computer, and the result says why: tell the user exactly that, not that it was closed. Not for Persona conversations (conversation_archive).",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "description": "the machine's id or name, as agents_list shows it"
        },
        "session_id": {
          "type": "string",
          "description": "the agent's session id, or its first 8 characters"
        },
        "close": {
          "type": "boolean",
          "description": "also close its agent on the computer (asks the user on the phone first); default false: archive only"
        }
      }
    }
  },
  {
    "name": "agent_unarchive",
    "description": "Bring an archived coding agent's session back into the Agents list (find it with agents_list and state archived). Nothing is reopened on the computer: a message to it (agent_send) resumes it. Persona also asks the agent's own tool to restore it where that tool archived it too; the result says whether it did.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "description": "the machine's id or name, as agents_list shows it"
        },
        "session_id": {
          "type": "string",
          "description": "the agent's session id, or its first 8 characters"
        }
      }
    }
  },
  {
    "name": "interaction_answer",
    "description": "Answer another agent's question for the user, in their place, when they said what to answer or told you to decide. Only a question can be answered this way: a tool permission, a plan and a terminal dialog are theirs to decide in the app, and the assistant's own question is never answered by itself. Every question must be answered by its own wording, with the option labels it offers; free text is not accepted (the user answers that in the app, or you use agent_send). A multi-select takes an array of labels.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id",
        "interaction_id",
        "answers"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "description": "the machine's id or name, as agents_list shows it"
        },
        "session_id": {
          "type": "string",
          "description": "the agent's session id, or its first 8 characters"
        },
        "interaction_id": {
          "type": "string",
          "description": "the waiting interaction's id, from agents_list"
        },
        "answers": {
          "type": "object",
          "description": "each question's own wording → the option label to pick; a multi-select gives an array of labels",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      }
    }
  },
  {
    "name": "inbox_suggest",
    "description": "Hand in your suggestion for the inbox event this conversation handles (one at a time: a new one replaces the last), and the event's recap. It waits in the user's inbox; nothing goes out until they confirm, and then the program does exactly what it says (you never send it yourself). `kind`: `reply` — one message to send, `text` in the user's voice, ready to go out as it is (no blanks to fill in like 【…】: leave out what you could not find and say so in `note`; for a Feishu sheet / Base item `changes` proposes moving rows' status: ref, field and one of the values the item lists); `agent` — an Agent to start, `text` its instruction (`machine` and `cwd` optional); `conclusion` — you dealt with it, `text` the conclusion, `outcome` `fyi` (worth knowing) or `done` (nothing to do). `handback: true` for one the user has to judge: their confirmation comes back here as an instruction instead of being carried out. `note`: one or two sentences on what you found and where. `recap`: the event's background, progress and where it is stuck (up to 600 characters), every time. `related`: ids of inbox items in other chats or sources this one is about. With only `recap` (no `kind`) it just updates the recap. Call it at the end of each turn. In a conversation the user handed an inbox item to (its context block names the item's id), pass that id as `item` and call it when you have something to write back to the item; it refuses an item not handed to this conversation or one the user already filed: answer in the chat then.",
    "input_schema": {
      "type": "object",
      "properties": {
        "item": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "reply",
            "agent",
            "conclusion"
          ]
        },
        "text": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "handback": {
          "type": "boolean"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "fyi",
            "done"
          ]
        },
        "recap": {
          "type": "string"
        },
        "machine": {
          "type": "string"
        },
        "cwd": {
          "type": "string"
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "field",
              "value"
            ],
            "properties": {
              "ref": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "inbox_draft",
    "description": "The older name of inbox_suggest with kind `reply`: prefer inbox_suggest. Submit the reply you drafted for the inbox item this conversation was started for. It waits in the user's inbox; they read it and send it with one tap (you never send it yourself). `text` is the reply in the user's voice, ready to go out as it is: no blanks to fill in (【…】) — leave out what you could not find and say so in `note`; `note` is one or two sentences on what you found and where, for the user to check the draft against. For a Feishu sheet / Base item, `changes` proposes moving rows' status (ref, field and one of the values the item lists); they are made when the user sends. Call it once, at the end.",
    "input_schema": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "field",
              "value"
            ],
            "properties": {
              "ref": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "inbox_folders",
    "description": "List the folders the user's inbox items are filed under: each `/`-separated path (`work/alerts/engine`, every segment a level) with its item count and open count, and whether automatic filing by the triage model is on. Give `folder` to also list the items filed in that folder and below, or `unfiled: true` for the items in no folder; each line has the item's id (what inbox_move takes), source, title, sender and whether it is done. Call it before inbox_move, to reuse a folder in use rather than open a near-duplicate.",
    "input_schema": {
      "type": "object",
      "properties": {
        "folder": {
          "type": "string",
          "description": "a folder path: also list the items filed there and below"
        },
        "unfiled": {
          "type": "boolean",
          "description": "also list the items in no folder"
        }
      }
    }
  },
  {
    "name": "inbox_move",
    "description": "Move inbox items into a folder, as the user would from the inbox: `items` are their ids (from inbox_folders, or the id of an item handed to this conversation), `folder` a `/`-separated path (`work/alerts/engine`; a new path makes the folder), or `\"\"` to take them out of every folder. Moved items stay where they are put: the triage model no longer files them. An unknown id or a path with no name in it moves nothing. Move only what the user asked for.",
    "input_schema": {
      "type": "object",
      "required": [
        "items",
        "folder"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "inbox item ids"
        },
        "folder": {
          "type": "string",
          "description": "the folder path, or \"\" for no folder"
        }
      }
    }
  },
  {
    "name": "kb_search",
    "description": "Search the knowledge base: summaries and metadata of chats, people, projects, docs, meetings, events, recordings (with their minutes and full transcripts), project timelines, the notes directories the user added (hits with an absolute path) and, with messages=true, the full message archive (newest days first). All words must match. Hits come in the order the files are read, not by relevance, so a broad search can fill the limit with chats: give kind to search one kind only, the entries whose name matches first, then as kb_list ranks them. A past meeting (its decisions, what is still open, who does what) is kind=recordings: found by its title, the calendar event's title or what was said; then kb_get it.",
    "input_schema": {
      "type": "object",
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "projects",
            "chats",
            "people",
            "docs",
            "meetings",
            "events",
            "recordings"
          ],
          "description": "only this kind's entries (no notes directories; the message archive only with chats)"
        },
        "messages": {
          "type": "boolean",
          "description": "also search the message archive (default true)"
        },
        "limit": {
          "type": "integer",
          "description": "default 40"
        }
      }
    }
  },
  {
    "name": "kb_list",
    "description": "List knowledge-base entities of one kind ranked by importance (P0 first), relevance to the user, recency: projects (short = a feature / launch, long = a team mission), chats, people, docs, meetings, events, recordings (transcripts of the user's phone / watch recordings, kept a few days; newest first, saying which have meeting minutes). Meetings, events and recordings show when they started, in the user's time zone. Optional tag filter.",
    "input_schema": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "projects",
            "chats",
            "people",
            "docs",
            "meetings",
            "events",
            "recordings"
          ]
        },
        "tag": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "description": "default 30"
        }
      }
    }
  },
  {
    "name": "kb_get",
    "description": "Read one entity: its metadata (links to people / chats / projects, tags), compressed context (summary.md), a project's timeline, a chat's messages of the last 7 days, a recording's meeting minutes with where each action item stands (a suggestion, or its to-do: open, done, cancelled, deleted) and its full timestamped transcript (recordings: the user's phone / watch recordings of the last days, text only), a meeting's or event's recordings. id from kb_list / kb_search (a project also by name).",
    "input_schema": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "projects",
            "chats",
            "people",
            "docs",
            "meetings",
            "events",
            "recordings"
          ]
        },
        "id": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "kb_update",
    "description": "Write to the knowledge base: create or change a project (name, project_kind short|long, status, goal, my_role, aliases, link chats / people, code dirs as \"\u003cmachine\u003e:\u003cpath\u003e\" so Agents there belong to it, append a timeline `log` line, replace its summary), or tag / annotate a chat, person, doc, meeting, event, recording (a recording's content is the phone's: only its tags, pinned and projects; importance P0–P3, relevance 0–100, tags, note, link projects). Tags set here are kept over the automatic ones. Use it whenever a conversation settles something about a project or person. Two projects that are the same work under two names: `merge_into`; two that were merged but are not: `unmerge` on the one merged away.",
    "input_schema": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "projects",
            "chats",
            "people",
            "docs",
            "meetings",
            "events",
            "recordings"
          ]
        },
        "id": {
          "type": "string",
          "description": "id, or a project's name (created when new)"
        },
        "merge_into": {
          "type": "string",
          "description": "projects only: fold this project into that one (slug or name) when they are the same work; nothing else is changed in the same call"
        },
        "unmerge": {
          "type": "boolean",
          "description": "projects only: undo the merge that folded this project (slug or name) into another: it is listed again and takes back its chats, people, items and aliases; nothing else is changed in the same call"
        },
        "name": {
          "type": "string"
        },
        "project_kind": {
          "type": "string",
          "enum": [
            "short",
            "long"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "paused",
            "done"
          ]
        },
        "goal": {
          "type": "string"
        },
        "my_role": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "importance": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "relevance": {
          "type": "integer"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string",
          "description": "Markdown, replaces summary.md"
        },
        "log": {
          "type": "string",
          "description": "one line appended to a project's timeline"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "remove_aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "projects: aliases that are not this project's (another project's name, too generic)"
        },
        "chats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "people": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dirs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  {
    "name": "kb_history_plan",
    "description": "Show or change what a source's history import reads. What is read of each chat comes from the knowledge base's selection (the same rules as daily ingestion; per-chat settings are changed here with `set`): the whole chat, only the user's own messages (with the messages around them) and mentions of the user, or nothing. Without `set` or `back_days` it refreshes the source's chat list and lists the chats grouped that way, largest first, with each chat's id and any per-chat setting of the user's. `set` changes per-chat settings, which apply to daily ingestion too: a chat by its id or exact name (a name two chats share is refused with their ids, a name no chat has gets close names; then nothing is changed); `read: false` never reads it, `read: true, store: true` keeps the whole chat (for `days`, or as the rules say), `read: true, store: false` only the user's messages and mentions, `reset: true` back to the rules. `back_days` limits how far back the import goes (null: as far as the rules keep messages). A change, or a refreshed list, that reads more than the user approved takes the approval back, so the import needs kb_history_resume again; reading less does not. Listing or changing never starts the import: show the user the list, apply the exceptions they name, show the result again, and only when they say to start call kb_history_resume. Needs `kb.history.enabled` in manager.json.",
    "input_schema": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "description": "connector id from kb.history.sources; omitted: every configured source (required with set or back_days)"
        },
        "set": {
          "type": "array",
          "description": "per-chat settings to change, all or none",
          "items": {
            "type": "object",
            "required": [
              "chat"
            ],
            "properties": {
              "chat": {
                "type": "string",
                "description": "the chat's id, or its exact name"
              },
              "read": {
                "type": "boolean",
                "description": "false: never read it (required unless reset)"
              },
              "store": {
                "type": "boolean",
                "description": "true: keep the whole chat; false: only the user's messages and mentions"
              },
              "days": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "with store: how many days its lines are kept (null: as the rules say)"
              },
              "reset": {
                "type": "boolean",
                "description": "remove the chat's setting: the rules decide again"
              }
            }
          }
        },
        "back_days": {
          "type": [
            "integer",
            "null"
          ],
          "description": "how many days back the import goes for this source; null: as far as the rules keep messages"
        }
      }
    }
  },
  {
    "name": "kb_history_status",
    "description": "How the history import is doing, per source: its state (running, resting, paused, stopped, done, waiting for approval or for the search index), whether its plan is approved, chats done / to go / paused / in error / unreadable with messages read and written, calls and messages in the last hour, the last slowdown, pause and stop with their reasons, and the last call. Read-only.",
    "input_schema": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "description": "one connector id; omitted: all configured sources"
        }
      }
    }
  },
  {
    "name": "kb_history_stop",
    "description": "Stop the history import now: it makes no further call until the user resumes it (the call in flight, if any, finishes; nothing is cancelled). Use it whenever the user says to stop or pause importing history.",
    "input_schema": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "description": "why, in a few words, as the user said it; shown in the status, never written to the log"
        }
      }
    }
  },
  {
    "name": "kb_history_resume",
    "description": "Approve a source's history import plan, as the selection reads it now, and start or resume the import (it also clears a stop). Only when the user has seen the plan (kb_history_plan) and explicitly says to start or resume; never on your own. After a stop, check kb_history_status first and tell the user why it stopped; `slow` keeps the slowest pace for the first two hours after the import starts again, the safe choice after a stop.",
    "input_schema": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "description": "connector id from kb.history.sources"
        },
        "slow": {
          "type": "boolean",
          "description": "the slowest pace for the first two hours of calls"
        }
      }
    }
  },
  {
    "name": "persona_settings",
    "description": "Read and change Persona's own settings for the user: their inbox sorting rules, how their inbox items link to their tasks, 关于我 (what you know about them), your default launcher (model), their mail accounts, which Claude Code config directories each machine keeps out of Agents, and each extension's settings (extension.\u003cid\u003e: what Settings › Extensions shows, like turning one of its features on). Start with action list (what there is, what each takes); get reads one. set / add / remove put a card on the user's phone that says what changes (before → after) and nothing changes until they approve; what the card needs filled in, like a mail password, the user types there, so never ask for passwords in the conversation. Change only what the user asked for.",
    "input_schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "list",
            "get",
            "set",
            "add",
            "remove"
          ],
          "description": "default list"
        },
        "key": {
          "type": "string",
          "description": "the setting, from list (inbox.rules, mail.accounts, extension.\u003cid\u003e…)"
        },
        "value": {
          "description": "set: the new value; add: the item (each setting's list entry says what)"
        },
        "id": {
          "type": "string",
          "description": "remove: which item (from get)"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "secret_run",
    "description": "Run commands on one of the user's computers that need a password only the user knows, typically its sudo password. Never ask for a password in the conversation, in ask_user or anywhere else: call this instead. The user gets a card in the Persona app (iPhone, Mac, Vision Pro, Android or the web) showing the computer, your purpose and every command verbatim, types the password there and taps Run; that computer's node then runs exactly those commands in order, each as the user with /bin/sh -c in the home directory and PATH=/usr/bin:/bin:/usr/sbin:/sbin (give other tools by their absolute path). Only a command that runs sudo with -S gets the password, as a line on its stdin; every other command gets an empty stdin. Write sudo as `sudo -S -k -p '' …`, one sudo per command and never after a pipe (sudo would read the pipe; run a pipeline as root with `sudo -S -k -p '' sh -c '…'`); a sudo without -S is refused. Where a sudoers rule says NOPASSWD, sudo does not read stdin and the command it runs gets the password instead, so do not give such a command anything that reads stdin. Commands are printable ASCII only (letters, digits, punctuation, spaces), so the card shows exactly what runs. The first command that fails stops the run. Never write a command that prints, stores or sends the password. You never see the password: the result is JSON with status (ran, failed, declined, expired or refused), the computer, a message and, for ran and failed, each command's exit_code, timed_out and output (stdout and stderr, clipped to its end); when a command's output held the password, none of it comes back (output_withheld: true). A command stopped at the timeout may still be running as root: check its state before asking again. declined, expired and refused mean nothing ran: tell the user, and ask again only if they want to. Windows computers cannot run it.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "purpose",
        "commands"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "description": "the computer to run on: its id or name, as agent_start takes it"
        },
        "purpose": {
          "type": "string",
          "description": "one sentence the card shows: why the password is needed"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 5,
          "description": "1 to 5 one-line shell commands of printable ASCII, at most 1000 characters each, run in order"
        },
        "delivery": {
          "type": "string",
          "enum": [
            "stdin"
          ],
          "description": "how the password reaches the commands: stdin, the default and only way"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800,
          "description": "for the whole run, default 300"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "model_profiles_list",
    "description": "List editable model profiles, current profile, changed fields, rollback and recent audit events. Profiles contain model settings only, never credentials.",
    "input_schema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "model_profile_get",
    "description": "Inspect one model profile by id. See its purpose bindings, launcher model fields and named execution tiers (the Agent presets). Add, change or remove a tier with persona_settings key model_profiles.tiers; other fields are edited through the model-profiles HTTP API. Saving does not apply purpose or launcher settings.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Profile id from model_profiles_list"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    }
  },
  {
    "name": "model_profile_switch",
    "description": "Switch atomically to a model profile by id when the user asks (for example economy or performance). Saves a before-image for model_profile_rollback and records actor/time. Applies on next model call or Agent start; does not interrupt running work. Inspect profiles first; do not assume economy needs any particular model.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Profile id from model_profiles_list"
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    }
  },
  {
    "name": "model_profile_rollback",
    "description": "Undo the last model-profile switch using its saved before-image. Restores only touched model settings, not launcher credentials or chat runtime. Inspect the rollback preview with model_profiles_list first; a second rollback redoes the switch.",
    "input_schema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "conversations_list",
    "description": "List Persona's own conversations (the 对话 sidebar), newest activity first: id, title, last activity, whether it is the main conversation, whether it is running now, and the gist of its last message. Archived ones are left out unless `include_archived`. This conversation is marked. Use it to find a conversation the user means (\"the one about the trip\") before reading, renaming, archiving or messaging it.",
    "input_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "only conversations whose title or last message contains this (case-insensitive)"
        },
        "include_archived": {
          "type": "boolean",
          "description": "also list archived conversations (marked as such)"
        },
        "limit": {
          "type": "integer",
          "description": "how many (default 30, max 100)"
        }
      }
    }
  },
  {
    "name": "conversation_read",
    "description": "Read the recent part of another Persona conversation (an id from conversations_list): the user's messages, what was answered, tool calls in short form, cut like agent_read. `turns` = how many recent exchanges (default 2, max 10).",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "full id or its first 8 characters"
        },
        "turns": {
          "type": "integer"
        }
      }
    }
  },
  {
    "name": "conversation_rename",
    "description": "Rename a Persona conversation. Titles read 「MMDD | 类型 | 主题」: give `kind` and `topic` and the hub puts the day the conversation started in front. A title the user gave stays: renaming one fails unless the user asked for this rename in so many words (then pass `user_asked`). The main conversation has no title to change.",
    "input_schema": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "topic"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "full id or its first 8 characters; this conversation's own id renames it"
        },
        "kind": {
          "type": "string",
          "enum": [
            "功能",
            "设计",
            "修复",
            "优化",
            "发布",
            "探索",
            "文档",
            "研究",
            "评审",
            "定时"
          ]
        },
        "topic": {
          "type": "string",
          "description": "what it is about, at most 14 characters"
        },
        "user_asked": {
          "type": "boolean",
          "description": "the user asked for this rename; needed to replace a title they gave"
        }
      }
    }
  },
  {
    "name": "conversation_archive",
    "description": "Archive a Persona conversation: it leaves the sidebar's list (it is kept, and listed under 已归档), nothing is deleted. Only when the user asks to tidy up or archive. The main conversation can't be archived. Archiving this conversation itself is allowed: the current turn finishes, and a new message from the user brings it back.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "full id or its first 8 characters"
        }
      }
    }
  },
  {
    "name": "conversation_unarchive",
    "description": "Bring an archived Persona conversation back into the sidebar's list (find it with conversations_list and include_archived).",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "full id or its first 8 characters"
        }
      }
    }
  },
  {
    "name": "conversation_new",
    "description": "Start a new Persona conversation with an opening message and return its id at once (it does not wait for the answer). For work that deserves its own thread, when the user asks for one. The message arrives marked as coming from this conversation; it is named after its first turn like any new conversation.",
    "input_schema": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "the opening message: everything the new conversation needs, it does not see this one"
        }
      }
    }
  },
  {
    "name": "conversation_send",
    "description": "Send a message to another Persona conversation (not this one). If it is running, the message waits until its current turn ends. The message arrives marked as coming from this conversation, so the other side can answer with conversation_send. Conversations passing messages back and forth are limited (a few hops from the user's message, a few messages per pair in ten minutes): don't reply just to acknowledge.",
    "input_schema": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "full id or its first 8 characters"
        },
        "text": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "task_plan",
    "description": "Hand the user a plan of one or more tasks for agents on their computers, instead of starting agents yourself. Use it for any work that takes an agent (code, research in a repo, anything longer than a few tool calls); one task per independent piece of work. Check machines_list for current machine resources and availability before choosing a machine. Fill in every field from what you know (the knowledge base, agents_list: which machine works in which directory, the user's habits); the user sees each choice as a chip they can change, with your one-line reason. Read-only tasks, tasks the user asked for themselves (user_requested), and kinds the user told you to start without asking, start at once; the rest wait as a card for the user's 开始. Either way this returns at once: don't wait, carry on. Each queued task is a todo (todo id) whose progress shows in your context snapshot; send to a task's agent with agent_send. Quick things you can do with a tool yourself (a reminder, an event) are not tasks. A task stays on its requested machine by default (machine_policy=fixed), including retries. An unavailable launcher fails there; do not reroute machine-local work. Use machine_policy=flexible only when the task may run on another computer: a failed health check can then move it, and its why says so. The response confirms queued dispatch, not a successful Agent start; inspect the task outcome. From the main conversation or a leader conversation (assistant.leaders) you supervise what you hand out: give each task done_when (results you can check) and expect_minutes; you get a 督办 message when one needs you, and you close it with task_review, not by repeating its agent's words. The answer lists work already going on that looks like the same task: check it before you let both go on. A todo this conversation opened that has no agent yet (one opened from a Lark topic: the message that handed it to you names its id) is the task's own: give that id as the task's todo_id and the agent works on it, instead of a new todo being made; any other todo_id is refused with why.",
    "input_schema": {
      "type": "object",
      "required": [
        "tasks"
      ],
      "properties": {
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "title",
              "prompt",
              "machine",
              "cwd",
              "readonly",
              "user_requested",
              "why"
            ],
            "properties": {
              "title": {
                "type": "string",
                "description": "the task in a short line the user reads on the card (Chinese, under 20 characters)"
              },
              "prompt": {
                "type": "string",
                "description": "the agent's first message: everything it needs to do the task without asking you"
              },
              "machine": {
                "type": "string",
                "description": "machine id; fixed target by default"
              },
              "machine_policy": {
                "type": "string",
                "enum": [
                  "fixed",
                  "flexible"
                ],
                "description": "fixed (default): keep this machine through preview, dispatch and retries; fail there if unavailable. flexible: explicitly permit health-based placement on another computer, only for work that is portable"
              },
              "cwd": {
                "type": "string",
                "description": "the project directory: absolute path or ~/…"
              },
              "launcher": {
                "type": "string",
                "description": "launcher name, one that machine has (a name it lacks is refused, listing the ones it has); empty: the default, or one the machine has when it lacks the default (claude first; the why says so)"
              },
              "model": {
                "type": "string",
                "description": "model id (an alias such as opus, or a gateway's own id; letters, digits and . _ - / : @ [ ] only, or a leading ~ as in ~vendor/model-latest); empty: the launcher's default"
              },
              "permission": {
                "type": "string",
                "enum": [
                  "default",
                  "acceptEdits",
                  "plan",
                  "auto",
                  "bypassPermissions"
                ],
                "description": "permission mode; empty: the default for writable tasks (the user's default permission mode, else Claude Code's default mode on that computer). readonly=true always uses plan, overriding this field"
              },
              "ultracode": {
                "type": "boolean",
                "description": "true for a large task (many files, checks from several angles): Claude Code runs every substantial step as a multi-agent workflow, slower and costlier; false for small or quick work. Claude Code agents only (2.1.284 or later): any other agent, or an older Claude Code, fails to start. Never put the word in the prompt or title instead"
              },
              "readonly": {
                "type": "boolean",
                "description": "true when the task only reads (looks things up, reads code, does not change project files). Forces permission=plan, including retries and card edits; a launcher that cannot honor plan mode is refused"
              },
              "user_requested": {
                "type": "boolean",
                "description": "true when the user asked for this very task in their latest message (told you to do it, to have an agent do it, to go ahead and start); false when it is your own idea or inferred from something they did not ask for"
              },
              "why": {
                "type": "string",
                "description": "one line (Chinese) on why this machine, directory and model"
              },
              "done_when": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "string"
                },
                "description": "what done means: results you will check before you accept it (Chinese, one each), e.g. 「PR 合并到 master」「浅色 / 深色截图贴进 PR」「线上 hub 已部署并验证」; the agent is told them"
              },
              "attachments": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string"
                },
                "description": "pictures and files the user gave you for it, by their absolute paths on your computer: a picture they sent (the path Claude Code gives it), a file the app put in their message. They are copied to the agent's computer and listed at the end of its message, and the text's mentions of them name the copies. Only those the user gave you in this conversation are accepted"
              },
              "expect_minutes": {
                "type": "integer",
                "minimum": 0,
                "description": "about how long the task should take, in minutes; a task with no progress for 1.5× that (at least 20 minutes) counts as stuck"
              },
              "project": {
                "type": "string",
                "description": "optional: the knowledge-base project it belongs to: the slug or name of an existing project, usually a long-term one for an area of the user's work (kb_list projects). Set it when the area is clear; never make up a near-duplicate of an existing project"
              },
              "todo_id": {
                "type": "string",
                "description": "optional: the todo this task runs on instead of a new one, when this conversation opened it and no agent is on it yet (the id the Lark-topic message gave you); at most one task per todo; leave it out for a task with no such todo"
              },
              "tier": {
                "type": "string",
                "description": "An Agent preset: one of the tiers the snapshot's 模型档位 line lists for the profile in use, each with what it is for; pick the one whose description fits the work. Resolved when the task actually starts, with the profile in use then. Explicit launcher/model/effort override its values."
              },
              "effort": {
                "type": "string",
                "description": "Explicit effort override; omit to use the tier or purpose default."
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "task_review",
    "description": "Review a task you handed out from this conversation (its todo id), after you checked its work yourself: each done_when criterion with its evidence (a PR link and that it merged, CI, a screenshot, what the live system answers) or what is missing. accepted closes the task (its agent is closed once it stays still); rework sends what is missing back to the same agent (resumed if it was closed) — at most 2 rounds, a third goes to the user instead; needs_user marks it waiting for the user's decision (its conclusion card asks them; without one, ask them yourself: ask_user, or notify_user if they are away, as the answer says); cancelled ends it (a duplicate, no longer wanted): its agents are closed and archived, and their waiting cards end. A leader conversation's needs_user also goes to the main conversation. From a conversation other than the main one, on a task it does not supervise, only accepted and cancelled apply: send what is missing to its agent with agent_send. Use it on every task a 督办 message says waits for review; don't accept on the agent's word alone. On a supervised task, accepted and needs_user send the user one conclusion card in Lark: the verdict (done, cannot be done, or needs your decision), reason (one sentence), link (one), and for needs_user your recommend, which the user takes by answering \"OK\"; so give outcome, reason and link with accepted, and reason and recommend with needs_user, and don't push the same result again. A deployed task already has a \"Please verify\" card from when its work went live: your accepted passes it for the user (marked verified by you), so they are not asked to press \"Pass\"; set user_check only when the user should still look at the result themselves (a UI change someone has to see), and then that card, or a new one, waits for them. A needs_user decision may carry a deadline: when it passes unanswered, a reversible one takes your recommend by default (recorded on the to-do as taken at the deadline), and one that cannot be undone is only reminded again; without a deadline it waits as before.",
    "input_schema": {
      "type": "object",
      "required": [
        "todo_id",
        "verdict"
      ],
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "the task's todo id (todo_…), from the 督办 message or the context snapshot"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "accepted",
            "rework",
            "needs_user",
            "cancelled"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "criterion",
              "met"
            ],
            "properties": {
              "criterion": {
                "type": "string",
                "description": "one done_when criterion (or what the task was for, when it had none)"
              },
              "met": {
                "type": "boolean"
              },
              "evidence": {
                "type": "string",
                "description": "what shows it is met (a link, a command's output), or what is missing"
              }
            }
          },
          "description": "each criterion, met or not, with its evidence or gap"
        },
        "note": {
          "type": "string",
          "description": "rework: what the agent is to do (Chinese, concrete); needs_user: what the user is to decide; cancelled: why; accepted: the result in a line"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "done",
            "cannot"
          ],
          "description": "accepted: done (the work is done or the answer is yes), or cannot (the task found it cannot be done); default done"
        },
        "reason": {
          "type": "string",
          "description": "accepted and needs_user: the conclusion card's one sentence of why (what the user is to decide, for needs_user), in the user's language; default the note's first line"
        },
        "link": {
          "type": "string",
          "description": "accepted and needs_user: the one link to the evidence (the PR, the page, the document); default the task's PR, a link in the note or checks, or the agent's conversation"
        },
        "recommend": {
          "type": "string",
          "description": "needs_user: the option you recommend, in a line; the user's \"OK\" takes it and it goes to the task's agent"
        },
        "deadline": {
          "type": "string",
          "description": "needs_user, optional: until when the decision waits, a duration (\"4h\", \"90m\") or an RFC 3339 time, 1 minute to 30 days ahead; needs recommend and reversible"
        },
        "user_check": {
          "type": "boolean",
          "description": "accepted only: the user is still to look at the result themselves (a UI change someone has to see): a \"Please verify\" card waits for their \"Pass\" instead of your acceptance passing it; default false"
        },
        "reversible": {
          "type": "boolean",
          "description": "with deadline: whether taking recommend can be undone later. false for deleting, sending anything to other people, spending money or changing production: those are never taken by default"
        }
      }
    }
  },
  {
    "name": "task_start_screen",
    "description": "Read the last 30 lines of the terminal tab a task's agent did not start in, while its computer keeps that tab (a 督办 message says until when): the question the tab's shell waits on, or where the agent's own screen stopped. Only for a task of this conversation whose start is being remedied; what it shows stays here, it is not kept with the task.",
    "input_schema": {
      "type": "object",
      "required": [
        "todo_id"
      ],
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "the task's id, as the 督办 message gives it"
        },
        "reason": {
          "type": "string",
          "description": "why you look, in the user's language (optional; kept with the task's history)"
        }
      }
    }
  },
  {
    "name": "task_start_keys",
    "description": "Type into the terminal tab a task's agent did not start in, while its computer keeps that tab and no agent runs there: text as is (no enter, at most 32 characters), then keys by name (\"enter\", \"esc\", \"ctrl+c\", \"y\", \"n\", \"up\", \"down\"…, at most 8). Use it to answer the question the tab's shell waits on, or to get past where the agent's screen stopped; read the tab first with task_start_screen and again after. The keys, the text and your reason are kept with the task's history. It starts nothing: start the agent again with task_retry.",
    "input_schema": {
      "type": "object",
      "required": [
        "todo_id",
        "reason"
      ],
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "the task's id, as the 督办 message gives it"
        },
        "text": {
          "type": "string",
          "maxLength": 32,
          "description": "text to type as is, before the keys"
        },
        "keys": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          },
          "description": "keys to press after the text, by name"
        },
        "reason": {
          "type": "string",
          "description": "why these keys, in the user's language, one sentence"
        }
      }
    }
  },
  {
    "name": "task_retry",
    "description": "Start a task's agent again after it did not start: in the same tab while its computer keeps it (after task_start_keys answered what stopped it), otherwise in a new tab (a start that failed for good is reopened). At most 3 times per task; the hub never retries by itself. It returns at once; whether the agent came up arrives as a 督办 message. Only for a task of this conversation; your reason is kept with the task's history.",
    "input_schema": {
      "type": "object",
      "required": [
        "todo_id",
        "reason"
      ],
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "the task's id, as the 督办 message gives it"
        },
        "reason": {
          "type": "string",
          "description": "why it should start now, in the user's language, one sentence"
        }
      }
    }
  },
  {
    "name": "todo_list",
    "description": "List the user's Persona to-dos (the To-dos page in the app, not Feishu tasks): open ones by default, earliest due first (those without a due date last), each with its id, title, state, priority, project, due date, reminder and the agents on it, and the first line of its notes. Times are in the user's time zone. Filter by state, by due date (due_before / due_after: a day or a moment), overdue ones only, with or without agents, by knowledge-base project, by kind (concerns only), or a word in the title or notes. Use it before changing a to-do, to find its id; ask with todo_get for one in full.",
    "input_schema": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "open",
            "done",
            "all"
          ],
          "description": "which to-dos: open (default), done, or all"
        },
        "due_before": {
          "type": "string",
          "description": "only those due by then: a day (2026-11-15, through its end) or a moment (2026-11-15 18:00, RFC 3339); leaves out those without a due date"
        },
        "due_after": {
          "type": "string",
          "description": "only those due from then on: a day or a moment; leaves out those without a due date"
        },
        "overdue": {
          "type": "boolean",
          "description": "only open ones whose due date has passed"
        },
        "with_agents": {
          "type": "boolean",
          "description": "true: only those agents work on (tasks); false: only the user's own"
        },
        "query": {
          "type": "string",
          "description": "words to find in the title or notes"
        },
        "project": {
          "type": "string",
          "description": "only the to-dos in this knowledge-base project (its slug or name)"
        },
        "kind": {
          "type": "string",
          "enum": [
            "todo",
            "concern"
          ],
          "description": "only concerns (things the user raised in the main conversation that wait for you to report their outcome), or only the other to-dos; both when left out"
        },
        "limit": {
          "type": "integer",
          "description": "at most this many (default 50, at most 200)"
        }
      }
    }
  },
  {
    "name": "todo_get",
    "description": "One of the user's Persona to-dos in full: its title, state, priority, due date, reminder (and whether it was pushed), when it was made and changed, the conversation and plan it came from when it is a task, its notes, the agents that work or worked on it, and the decisions in force on it.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "the to-do's id (todo_…), as todo_list gives it"
        }
      }
    }
  },
  {
    "name": "todo_create",
    "description": "Add a to-do to the user's Persona to-dos, when the user asks you to note something to do or to remind them of it (or agrees to your suggestion): it shows on the To-dos page of the app, sorted by its due date, and with remind set the phone is pushed about it at that time. It is the user's own to-do, with no agent on it: work for an agent is task_plan. Done at once, nothing to confirm. An open to-do with the same title and due date is not made twice: you get that one back. Write the title as the thing to do (short, the user's language); put links, amounts and details in notes. Read due dates and times in the user's time zone; when only the day is known, give the day. When it clearly belongs to one of the user's areas of work, give project: the To-dos page groups to-dos by it. With kind concern it records a concern of the user's instead: open until you report its outcome with concern_report.",
    "input_schema": {
      "type": "object",
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "what is to be done, in a line"
        },
        "notes": {
          "type": "string",
          "description": "details: where it came from, links, amounts, what to bring"
        },
        "due": {
          "type": "string",
          "description": "when it is due: a day (2026-11-15) when only the day is known, else a moment (2026-11-15 18:00 in the user's time zone, or RFC 3339 with its offset); 2h / 3d from now also work"
        },
        "remind": {
          "type": "string",
          "description": "when to push the phone about it: a moment (2026-11-14 09:00 in the user's time zone, or RFC 3339), or 30m / 2h / 1d from now; not in the past. Leave it out unless the user asked for a reminder or the deadline is close and matters"
        },
        "priority": {
          "type": "string",
          "enum": [
            "high",
            "normal",
            "low"
          ],
          "description": "normal when left out"
        },
        "kind": {
          "type": "string",
          "enum": [
            "todo",
            "concern"
          ],
          "description": "concern (main conversation only): something the user raised and wants an answer to, recorded so it is followed until you report its outcome to them with concern_report; nothing else closes it. todo (the default): one of the user's own to-dos"
        },
        "project": {
          "type": "string",
          "description": "the knowledge-base project it belongs to: the slug or name of an existing project, usually a long-term one for an area of the user's work (kb_list projects). Set it when the area is clear; never make up a near-duplicate of an existing project"
        }
      }
    }
  },
  {
    "name": "todo_update",
    "description": "Change one of the user's Persona to-dos: its title, notes, due date, reminder, priority or project. Only what you give changes; \"\" clears notes, due, remind or project. A new reminder time is pushed again even when the old one already was. Done at once, nothing to confirm, also for a task's to-do. To mark it done or open it again use todo_complete / todo_reopen.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "the to-do's id (todo_…), as todo_list gives it"
        },
        "title": {
          "type": "string",
          "description": "the new title"
        },
        "notes": {
          "type": "string",
          "description": "the new notes (they replace the old ones: keep what should stay); \"\" clears them"
        },
        "due": {
          "type": "string",
          "description": "the new due date: a day (2026-11-15) or a moment (2026-11-15 18:00 in the user's time zone, RFC 3339); \"\" clears it"
        },
        "remind": {
          "type": "string",
          "description": "the new reminder: a moment (2026-11-14 09:00, RFC 3339) or 30m / 2h / 1d from now, not in the past; \"\" clears it"
        },
        "priority": {
          "type": "string",
          "enum": [
            "high",
            "normal",
            "low"
          ]
        },
        "project": {
          "type": "string",
          "description": "the knowledge-base project it belongs to: the slug or name of an existing project, usually a long-term one for an area of the user's work (kb_list projects). Set it when the area is clear; never make up a near-duplicate of an existing project; \"\" takes it out of its project"
        }
      }
    }
  },
  {
    "name": "todo_complete",
    "description": "Mark one of the user's Persona to-dos done, when the user says it is done (or asks you to close it). The user's own to-do is closed at once. A task's, or one agents work on, is confirmed on the phone first, because closing it also closes its agents once they are idle; if the user declines, nothing changes. A concern is not closed with this: report its outcome with concern_report.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "the to-do's id (todo_…), as todo_list gives it"
        }
      }
    }
  },
  {
    "name": "todo_reopen",
    "description": "Open a done Persona to-do again, when the user says it is not done after all. The user's own to-do is reopened at once; a task's, or one agents worked on, is confirmed on the phone first.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "the to-do's id (todo_…), as todo_list gives it"
        }
      }
    }
  },
  {
    "name": "todo_delete",
    "description": "Delete one of the user's Persona to-dos for good (its notes, links to agents and decisions go with it), only when the user asks for it to be deleted; one that is finished is completed instead (todo_complete). Every delete is confirmed on the phone first; if the user declines, writes instead, or does not answer, nothing is deleted. The agents that worked on it are left as they are.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "the to-do's id (todo_…), as todo_list gives it"
        }
      }
    }
  },
  {
    "name": "concern_report",
    "description": "Report the outcome of one of the user's concerns (a to-do of kind concern, see todo_list kind concern) and close it: main conversation only. Call it in the same reply in which you tell the user the outcome, with report the words you told them, faithfully; it is kept on the concern as a decision of source reported (shown in the app, sent to extensions). It is the only way a concern closes: nothing closes one on its own, and todo_complete refuses it. Report only an outcome the user has actually been told; if the concern is not settled yet, leave it open. A concern the user reopens needs another report.",
    "input_schema": {
      "type": "object",
      "required": [
        "id",
        "report"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "the concern's id (todo_…), as todo_list gives it"
        },
        "report": {
          "type": "string",
          "description": "what you told the user of its outcome, as you said it in this reply (at most 4000 characters)"
        }
      }
    }
  },
  {
    "name": "jarvis_settings",
    "description": "Read and change Persona's own settings for the user: their inbox sorting rules, how their inbox items link to their tasks, 关于我 (what you know about them), your default launcher (model), their mail accounts, which Claude Code config directories each machine keeps out of Agents, and each extension's settings (extension.\u003cid\u003e: what Settings › Extensions shows, like turning one of its features on). Start with action list (what there is, what each takes); get reads one. set / add / remove put a card on the user's phone that says what changes (before → after) and nothing changes until they approve; what the card needs filled in, like a mail password, the user types there, so never ask for passwords in the conversation. Change only what the user asked for.",
    "input_schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "list",
            "get",
            "set",
            "add",
            "remove"
          ],
          "description": "default list"
        },
        "key": {
          "type": "string",
          "description": "the setting, from list (inbox.rules, mail.accounts, extension.\u003cid\u003e…)"
        },
        "value": {
          "description": "set: the new value; add: the item (each setting's list entry says what)"
        },
        "id": {
          "type": "string",
          "description": "remove: which item (from get)"
        }
      },
      "additionalProperties": false
    }
  }
]
